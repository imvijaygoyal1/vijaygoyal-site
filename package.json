{
  "name": "vijaygoyal-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "e2e": "playwright test --grep-invert @perf",
    "lh": "lhci autorun",
    "deploy": "npm run check-facts && npm run build && wrangler deploy",
    "check-facts": "node scripts/facts/check.ts",
    "record-release": "node scripts/facts/record.ts"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "13.1.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "size-limit": "13.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.146.0"
  },
  "overrides": {
    "tmp": "^0.2.4",
    "uuid": "^11.1.1"
  }
}
