# Security headers, applied by Cloudflare static assets to every response.
# Tested in src/security/headers.test.ts (the values) and e2e/headers.spec.ts
# (the page runs under this policy with nothing blocked).
#
# HSTS is one month and this host only: it cannot be withdrawn early, and
# includeSubDomains would bind shadyspade. and xbill., which are separate
# deployments. Lengthen it once it has run without trouble.
#
# cloudflareinsights.com is Cloudflare Web Analytics, which Cloudflare injects
# at the edge; without it the policy blocks the beacon and analytics stop.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=2592000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
